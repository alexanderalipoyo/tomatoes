{
  "name": "tomatoes-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node src/server/index.js",
    "check": "node scripts/check.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.js",
    "db:check": "node scripts/check-database.js",
    "db:migrate": "node scripts/database.js migrate",
    "db:import-files": "node scripts/database.js import-files",
    "test:postgres": "node scripts/test.js --postgres",
    "team:admin": "node scripts/team-admin.js",
    "report:publish": "node scripts/publish-report.js",
    "start:production": "node --env-file=.env.production src/server/index.js",
    "db:check:production": "node --env-file=.env.production scripts/check-database.js",
    "db:migrate:production": "node --env-file=.env.production scripts/database.js migrate",
    "build": "node scripts/build.js",
    "build:production": "npm run check && npm test && npm run build",
    "vercel-build": "npm run build",
    "deploy:check": "node scripts/check-deployment.js",
    "prestart": "npm run build",
    "prestart:production": "npm run build",
    "pretest": "npm run build",
    "db:verify": "node scripts/check-schema.js",
    "db:verify:production": "node --env-file=.env.production scripts/check-schema.js",
    "android:build:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android/build.ps1 -Mode Local",
    "android:build:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android/build.ps1 -Mode Production",
    "android:run:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android/build.ps1 -Mode Local -Run",
    "android:run:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/android/build.ps1 -Mode Production -Run",
    "ios:sync": "node scripts/ios-production.mjs sync",
    "ios:sync:local": "node scripts/ios-local.mjs sync",
    "ios:open": "node scripts/ios-production.mjs open",
    "ios:build:prod": "node scripts/ios-production.mjs build",
    "ios:run:prod": "node scripts/ios-production.mjs run",
    "ios:launch:prod": "node scripts/ios-production.mjs launch",
    "ios:build:local": "node scripts/ios-local.mjs build",
    "ios:run:local": "node scripts/ios-local.mjs run",
    "ios:launch:local": "node scripts/ios-local.mjs launch",
    "ios:archive:prod": "node scripts/ios-production.mjs archive",
    "ios:export:prod": "node scripts/ios-production.mjs export",
    "ios:run:prod:iphone18pro": "node scripts/ios-production.mjs run \"iPhone 18 Pro\"",
    "ios:launch:prod:iphone18pro": "node scripts/ios-production.mjs launch \"iPhone 18 Pro\"",
    "ios:run:prod:iphone18promax": "node scripts/ios-production.mjs run \"iPhone 18 Pro Max\"",
    "ios:launch:prod:iphone18promax": "node scripts/ios-production.mjs launch \"iPhone 18 Pro Max\"",
    "ios:run:prod:iphoneduo": "node scripts/ios-production.mjs run \"iPhone Duo\"",
    "ios:launch:prod:iphoneduo": "node scripts/ios-production.mjs launch \"iPhone Duo\""
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@vercel/analytics": "2.0.1",
    "google-auth-library": "11.3.2",
    "jspdf": "4.2.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": "24.x"
  }
}
