# Copy to .env.local and keep the password private.
# Choose postgres for database storage, or files for the original local file store.
TOMATOES_STORAGE=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tomatoes
PGUSER=postgres
PGPASSWORD=
# Optional local attachment/file storage folder:
# TOMATOES_DATA_DIR=C:/path/to/private/tomatoes-data

# Slack notifications after successful browser imports (server-side only).
TOMATOES_SLACK_WEBHOOK_URL=
TOMATOES_SLACK_ENABLED=true
# Optional reachable dashboard origin for Slack links; defaults to this server's request origin.
# TOMATOES_REPORT_BASE_URL=http://localhost:3000
