# Copy to .env.local and keep the password private.
# Choose postgres for database storage, or files for the original local file store.
TOMATOES_STORAGE=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tomatoes
PGUSER=postgres
PGPASSWORD=
# Optional local attachment/file storage folder:
# TOMATOES_DATA_DIR=C:/path/to/private/tomatoes-data
