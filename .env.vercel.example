# Set in Vercel > Project > Settings > Environment Variables.
# Use a separate Supabase project/database for Preview deployments.
NODE_ENV=production
TOMATOES_STORAGE=postgres
TOMATOES_TEAM_MODE=1
PGHOST=aws-0-eu-west-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.lvxukujhmrbvgwpxbnsa
PGPASSWORD=
PGSSLMODE=verify-full
# Paste the PEM certificate as a multiline value, or use PGSSLROOTCERT_BASE64 instead.
PGSSLROOTCERT_PEM=
# TOMATOES_PUBLIC_ORIGIN=https://your-app.vercel.app
# TOMATOES_REPORT_BASE_URL=https://your-app.vercel.app
TOMATOES_SLACK_ENABLED=false
# Optional hosted recovery email: verified sender and a Resend API key.
RESEND_API_KEY=
TOMATOES_AUTH_EMAIL_FROM=
# Optional scoped CI publishing credentials.
TOMATOES_CI_TOKEN=
TOMATOES_CI_PROJECT=tomatoes
